# Google/Microsoft OAuth credentials for ops-api dev.
# Copy this file to .env.oauth and fill in real values. .env.oauth is gitignored.
#
# Port layout: ops-api-<i> listens on (9780 + N*100) where A=0, B=1, … F=5.
# Today the stack runs ops-api-a (:9780) and ops-api-b (:9880); the C-F slots
# are reserved so you only need to register OAuth URIs in the Console once.
#
# Register a single OAuth 2.0 Client at https://console.cloud.google.com/apis/credentials
# (Application type: Web). On the same client, add ALL of these as
# "Authorized redirect URIs":
#   http://localhost:9780/auth/google/callback   # ops-api-a (active)
#   http://localhost:9880/auth/google/callback   # ops-api-b (active)
#   http://localhost:9980/auth/google/callback   # ops-api-c (reserved)
#   http://localhost:10080/auth/google/callback  # ops-api-d (reserved)
#   http://localhost:10180/auth/google/callback  # ops-api-e (reserved)
#   http://localhost:10280/auth/google/callback  # ops-api-f (reserved)
#
# And the matching origins as "Authorized JavaScript origins":
#   http://localhost:9780, :9880, :9980, :10080, :10180, :10280
#
# Empty values keep /auth/google/login returning 404 (ops-api still boots fine).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (optional). Same pattern - register an App Registration in Azure AD
# with redirect URIs at /auth/microsoft/callback on each port (9780, 9880, 9980,
# 10080, 10180, 10280).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email of the admin user to create on each ops-api via POST /admin/bootstrap.
# When set, start_dev.sh runs the bootstrap + on-chain PRIVACY_NODE_OPERATOR
# grant for every participant after the stack is healthy. Leave empty to skip.
# Use the same email you'll log in with via Google OAuth so /api/me works.
OPS_ADMIN_EMAIL=

# ── Playground (per-chain) optional overrides ─────────────────────────────────
# Auditor wallet addresses surface admin views in the playground (one per chain).
# Leave empty unless you have deployed an auditor wallet for that chain in dev.
PH_AUDITOR_ADDRESS=
PN_A_AUDITOR_ADDRESS=
PN_B_AUDITOR_ADDRESS=

# Optional WalletConnect project id (shared by all playground instances).
WALLETCONNECT_PROJECT_ID=
