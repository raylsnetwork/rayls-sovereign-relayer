# OPEN TELEMETRY
OTEL_SDK_DISABLED=
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=

# Fault Injection (testing only — NEVER enable in production).
# FAULT_INJECTION_ENABLED is a single master switch shared across private-
# relayer, public-relayer and KOS; each service has its own port + persist
# path so the three services running off the same .env don't collide.
# *_PERSIST_PATH is optional: leave blank to keep session state in-memory
# only (the default). Set to a writable file path to fsync the session
# table on every mutation and restore it on Enable() — required for the
# "consume-then-crash" semantics of one-shot crash rules to survive process
# restart.
FAULT_INJECTION_ENABLED=false
# private-relayer
FAULT_INJECTION_PORT=9999
FAULT_INJECTION_PERSIST_PATH=
# public-relayer
PUBLIC_RELAYER_FAULT_INJECTION_PORT=9998
PUBLIC_RELAYER_FAULT_INJECTION_PERSIST_PATH=
# KOS
KOS_FAULT_INJECTION_PORT=9997
KOS_FAULT_INJECTION_PERSIST_PATH=
