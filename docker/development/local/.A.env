# Env var names updated to new glossary terminology
# DEV_MODE=local
PNH_CHAIN_ID=
PNH_CHAIN_STARTING_BLOCK=
PNH_ATOMIC_REVERT_STARTING_BLOCK=
PNH_OPERATOR_CHAIN_ID=
PNH_DEPLOYMENT_PROXY_REGISTRY=
PNH_ENDPOINT_MAX_BATCH_MESSAGES=
PNH_EXPIRATION_REVERT_TIME_IN_MINUTES=

PRIVATE_RELAYER_DATABASE_CONNECTIONSTRING=postgres://admin:admin@postgres:5432/relayerA?sslmode=disable
CTS_API_KEY=*
CTS_SECRET=a_random-secret
CTS_GRPC_URL=cts-a:8080
PRIVACY_NODE_CHAIN_ID=12345
PRIVACY_NODE_RPC_URL=http://pn-a:8545

PRIVACY_NODE_STARTING_BLOCK=
PRIVACY_NODE_EXECUTOR_BATCH_MESSAGES=500
BLOCKCHAIN_LISTENER_BATCH_BLOCKS=100
PRIVACY_NODE_EXECUTOR_ENYGMA_BATCH_MESSAGES=1000
PRIVACY_NODE_EXECUTOR_ENYGMA_MAX_CONCURRENT_RESOURCE_IDS=2
PRIVACY_NODE_DEPLOYMENT_PROXY_REGISTRY=

# Enygma Configuration
PRIVACY_NODE_ENYGMA_PROOF_API_ADDRESS=http://proofs-api:3003

# Private Network Hub (PNH) Configuration
PNH_RPC_URL=http://private-hub:3445
PNH_VERSION=2.0

# Public Chain
PUBLIC_CHAIN_RPC_URL=http://public-chain:8845
RAYLS_NODE_DATABASE_CONNECTIONSTRING=postgres://admin:admin@postgres:5432/publicRelayerA?sslmode=disable

# KMS Configuration
CTS_DATABASE_CONNECTIONSTRING=postgres://admin:admin@postgres:5432/ctsA?sslmode=disable
CTS_GCPPROJECT=xxx
CTS_GCPLOCATION=xxx
CTS_GCPKEYRING=xxx
CTS_GCPCRYPTOKEY=xxx
CTS_AWSPROFILE=xxx
CTS_AWSALIAS=xxx
CTS_CORSDOMAIN=*
CTS_API_KEY=*
CTS_SECRET=a_random-secret
CTS_GCPRESOURCENAME=gcp
CTS_ENCRYPTORSERVICE=plaintext
BLOCKCHAIN_CHAIN_ID=12345
CTS_HTTP_PORT=8090
CTS_GRPC_PORT=8080

# Healthcheck
PRIVATE_RELAYER_HEALTHCHECK_PORT=9000
ATOMIC_HEALTHCHECK_PORT=9020

# Logger Configuration
LOG_LEVEL=INFO
LOG_HANDLER=Text

# Timeout for Enygma proof generation and tx
DVP_MERKLE_TREE_DEPTH=8

# OPEN TELEMETRY
OTEL_SDK_DISABLED=false # set this to `true` to disable the OpenTelemetry SDK (logging, tracing, metrics)
# OTEL_SERVICE_NAME=service-x # overriden by docker-compose env
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL=1000 # default is 60000 (60s)

NATS_URL=nats://nats:4222
NUMBER_OF_JS_PARAMS_IN=10

# Fault Injection (testing only — never enable in production).
# FAULT_INJECTION_ENABLED is a single master switch shared across private-
# relayer, public-relayer and KOS; each service has its own port + persist
# path so the three instances per participant don't collide.
FAULT_INJECTION_ENABLED=true
# private-relayer
FAULT_INJECTION_PORT=6660
FAULT_INJECTION_PERSIST_PATH=/tmp/faultinjector_state_a.json
# public-relayer
PUBLIC_RELAYER_FAULT_INJECTION_PORT=6700
PUBLIC_RELAYER_FAULT_INJECTION_PERSIST_PATH=/tmp/faultinjector_pubrelayer_state_a.json
# KOS
KOS_FAULT_INJECTION_PORT=6800
KOS_FAULT_INJECTION_PERSIST_PATH=/tmp/faultinjector_kos_state_a.json

